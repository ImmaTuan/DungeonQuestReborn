local TARGET_USERNAME = getgenv().Config.TargetUser

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer

-- Cấu hình Remote Events
local remotes = ReplicatedStorage:WaitForChild("remotes")
local sellItemEvent = remotes:WaitForChild("sellItemEvent")
local returnToLobbyEvent = remotes:FindFirstChild("ReturnToLobbyEvent")
local joinDungeonEvent = remotes:FindFirstChild("joinDungeon")
local sendJoinRequestEvent = remotes:FindFirstChild("sendJoinRequest")
local buyGamepassEvent = remotes:FindFirstChild("requestGoldGamepassPurchase")

local targetHasBeenSeen = false

local purchaseQueue = {
    "goldGamepass",
    "extraItemGamepass",
    "vip",
    "freeStatResets"
}

-- 0. Chức năng Boost FPS & Black Screen
local function applyOptimizations()
    -- Xử lý Boost FPS (Xóa bớt hiệu ứng, particle, vật thể nặng)
    if getgenv().Config.BoostFPS then
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
                    v.Enabled = false
                end
            end
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                    v.Enabled = false
                elseif v:IsA("BasePart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                end
            end
        end)
    end

    -- Xử lý Black Screen (Tạo khung đen che màn hình game để giảm tải render khi treo máy)
    if getgenv().Config.BlackScreen then
        pcall(function()
            local playerGui = player:FindFirstChild("PlayerGui")
            if playerGui and not playerGui:FindFirstChild("TreoBlackScreenGui") then
                local screenGui = Instance.new("ScreenGui")
                screenGui.Name = "TreoBlackScreenGui"
                screenGui.IgnoreGuiInset = true
                screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
                screenGui.DisplayOrder = 999999

                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 1, 0)
                frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                frame.BorderSizePixel = 0
                frame.Parent = screenGui

                local textLabel = Instance.new("TextLabel")
                textLabel.Size = UDim2.new(1, 0, 0, 50)
                textLabel.Position = UDim2.new(0, 0, 0.5, -25)
                textLabel.BackgroundTransparency = 1
                textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                textLabel.TextScaled = true
                textLabel.Font = Enum.Font.SourceSansBold
                textLabel.Text = "TREO GAME ĐANG BẬT - TỐI ƯU HÓA HOẠT ĐỘNG"
                textLabel.Parent = frame

                screenGui.Parent = playerGui
            end
        end)
    else
        -- Nếu tắt BlackScreen thì xóa UI đi nếu có
        pcall(function()
            local playerGui = player:FindFirstChild("PlayerGui")
            if playerGui and playerGui:FindFirstChild("TreoBlackScreenGui") then
                playerGui.TreoBlackScreenGui:Destroy()
            end
        end)
    end
end

-- 1. Auto Sell (quét từ 1 đến 100 nếu được bật trong config)
local function autoSellAll()
    if not getgenv().Config.AutoSellEnabled then return end

    local itemsToSell = {
        helmet = {},
        ability = {},
        chest = {},
        weapon = {}
    }

    for i = 1, 100 do
        table.insert(itemsToSell.helmet, i)
        table.insert(itemsToSell.ability, i)
        table.insert(itemsToSell.chest, i)
        table.insert(itemsToSell.weapon, i)
    end

    pcall(function()
        sellItemEvent:FireServer(itemsToSell)
    end)
end

-- 2. Tự động mua gamepass theo thứ tự
local function checkAndBuyGamepasses()
    if not buyGamepassEvent then return end

    for _, passName in ipairs(purchaseQueue) do
        local valueObj = player:FindFirstChild(passName)
        
        if valueObj and valueObj:IsA("BoolValue") and valueObj.Value == false then
            pcall(function()
                buyGamepassEvent:FireServer(passName)
            end)
            break 
        end
    end
end

-- 3. Join Dungeon & Request
local function triggerJoin()
    if TARGET_USERNAME and TARGET_USERNAME ~= "" then
        pcall(function()
            if joinDungeonEvent then
                joinDungeonEvent:InvokeServer(TARGET_USERNAME)
            end
        end)

        pcall(function()
            if sendJoinRequestEvent then
                sendJoinRequestEvent:InvokeServer(TARGET_USERNAME)
            end
        end)
    end
end

-- 4. Check Leave để về Lobby
local function checkTargetPlayerLeave()
    local targetPlayer = Players:FindFirstChild(TARGET_USERNAME)

    if targetPlayer then
        if not targetHasBeenSeen then
            targetHasBeenSeen = true
            print("Đã phát hiện " .. TARGET_USERNAME .. " xuất hiện trong game!")
        end
    else
        if targetHasBeenSeen then
            print(TARGET_USERNAME .. " đã rời đi! Đang tiến hành về Lobby...")
            
            if returnToLobbyEvent then
                pcall(function()
                    returnToLobbyEvent:FireServer()
                end)
            end
            
            targetHasBeenSeen = false 
        end
    end
end

-- Áp dụng cấu hình tối ưu lúc khởi động
applyOptimizations()

-- 5. Vòng lặp tổng hợp
task.spawn(function()
    local sellTimer = 0
    local buyTimer = 0
    
    while true do
        checkTargetPlayerLeave()
        task.spawn(triggerJoin)

        buyTimer = buyTimer + 1
        if buyTimer >= 2 then
            buyTimer = 0
            checkAndBuyGamepasses()
        end

        sellTimer = sellTimer + 1
        if sellTimer >= 3 then
            sellTimer = 0
            autoSellAll()
        end

        task.wait(1)
    end
end)

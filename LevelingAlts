

local TARGET_USERNAME = getgenv().Config.TargetUser

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")
local player = Players.LocalPlayer

-- Cấu hình Remote Events
local remotes = ReplicatedStorage:WaitForChild("remotes")
local sellItemEvent = remotes:WaitForChild("sellItemEvent")
local returnToLobbyEvent = remotes:FindFirstChild("ReturnToLobbyEvent")
local joinDungeonEvent = remotes:FindFirstChild("joinDungeon")
local sendJoinRequestEvent = remotes:FindFirstChild("sendJoinRequest")
local buyGamepassEvent = remotes:FindFirstChild("requestGoldGamepassPurchase")

local targetHasBeenSeen = false
local missingTargetTimer = 0

local purchaseQueue = {
    "goldGamepass",
    "extraItemGamepass",
    "vip",
    "freeStatResets"
}

-- Biến lưu trữ TextLabel để cập nhật thông tin lên màn hình đen
local blackScreenTextLabel = nil

-- Hàm rút gọn số tiền theo định dạng K, M, B, T
local function formatNumber(value)
    local num = tonumber(value)
    if not num then return tostring(value) end
    
    if num >= 1e12 then
        return string.format("%.2fT", num / 1e12)
    elseif num >= 1e9 then
        return string.format("%.2fB", num / 1e9)
    elseif num >= 1e6 then
        return string.format("%.2fM", num / 1e6)
    elseif num >= 1e3 then
        return string.format("%.2fK", num / 1e3)
    else
        return tostring(num)
    end
end

-- 0. Tối ưu hóa FPS & Màn hình đen
local function applyOptimizations()
    if getgenv().Config.BoostFPS then
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
                    v.Enabled = false
                end
            end
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                    v.Enabled = false
                elseif v:IsA("BasePart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                end
            end
        end)
    end

    if getgenv().Config.BlackScreen then
        pcall(function()
            local playerGui = player:FindFirstChild("PlayerGui")
            if playerGui and not playerGui:FindFirstChild("TreoBlackScreenGui") then
                local screenGui = Instance.new("ScreenGui")
                screenGui.Name = "TreoBlackScreenGui"
                screenGui.IgnoreGuiInset = true
                screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
                screenGui.DisplayOrder = 999999

                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 1, 0)
                frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                frame.BorderSizePixel = 0
                frame.Parent = screenGui

                blackScreenTextLabel = Instance.new("TextLabel")
                blackScreenTextLabel.Size = UDim2.new(1, 0, 0, 150)
                blackScreenTextLabel.Position = UDim2.new(0, 0, 0.5, -75)
                blackScreenTextLabel.BackgroundTransparency = 1
                blackScreenTextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                blackScreenTextLabel.TextScaled = true
                blackScreenTextLabel.Font = Enum.Font.SourceSansBold
                blackScreenTextLabel.Text = "Đang tải thông tin..."
                blackScreenTextLabel.Parent = frame

                screenGui.Parent = playerGui
            end
        end)
    else
        pcall(function()
            local playerGui = player:FindFirstChild("PlayerGui")
            if playerGui and playerGui:FindFirstChild("TreoBlackScreenGui") then
                playerGui.TreoBlackScreenGui:Destroy()
                blackScreenTextLabel = nil
            end
        end)
    end
end

-- Cập nhật thông tin chi tiết lên màn hình đen (Gold đã được quy đổi K, M, B, T)
local function updateBlackScreenStats()
    if not getgenv().Config.BlackScreen or not blackScreenTextLabel then return end

    pcall(function()
        local username = player.Name
        
        -- Lấy Level và Gold từ leaderstats
        local leaderstats = player:FindFirstChild("leaderstats")
        local levelVal = leaderstats and leaderstats:FindFirstChild("Level")
        local goldVal = leaderstats and leaderstats:FindFirstChild("Gold")

        local currentLevel = levelVal and levelVal.Value or "N/A"
        local rawGold = goldVal and goldVal.Value or 0
        local currentGold = formatNumber(rawGold) -- Rút gọn Gold

        -- Lấy tên map từ dungeonName trong Workspace
        local dungeonNameVal = Workspace:FindFirstChild("dungeonName")
        local currentMap = dungeonNameVal and dungeonNameVal.Value or "Lobby / Chưa vào Map"

        blackScreenTextLabel.Text = string.format(
            "Account: %s\nLevel: %s | Gold: %s\nMap: %s", 
            tostring(username), 
            tostring(currentLevel), 
            currentGold, 
            tostring(currentMap)
        )
    end)
end

-- Chức năng Anti-AFK (mô phỏng thao tác nhảy)
local function triggerAntiAFK()
    if not getgenv().Config.AntiAFK then return end

    pcall(function()
        local character = player.Character or player.CharacterAdded:Wait()
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.Jump = true
        end
    end)
end

-- 1. Auto Sell
local function autoSellAll()
    if not getgenv().Config.AutoSellEnabled then return end

    local itemsToSell = {
        helmet = {},
        ability = {},
        chest = {},
        weapon = {}
    }

    for i = 1, 100 do
        table.insert(itemsToSell.helmet, i)
        table.insert(itemsToSell.ability, i)
        table.insert(itemsToSell.chest, i)
        table.insert(itemsToSell.weapon, i)
    end

    pcall(function()
        sellItemEvent:FireServer(itemsToSell)
    end)
end

-- 2. Tự động mua gamepass theo thứ tự
local function checkAndBuyGamepasses()
    if not buyGamepassEvent then return end

    for _, passName in ipairs(purchaseQueue) do
        local valueObj = player:FindFirstChild(passName)
        
        if valueObj and valueObj:IsA("BoolValue") and valueObj.Value == false then
            pcall(function()
                buyGamepassEvent:FireServer(passName)
            end)
            break 
        end
    end
end

-- 3. Join Dungeon & Request
local function triggerJoin()
    if TARGET_USERNAME and TARGET_USERNAME ~= "" then
        pcall(function()
            if joinDungeonEvent then
                joinDungeonEvent:InvokeServer(TARGET_USERNAME)
            end
        end)

        pcall(function()
            if sendJoinRequestEvent then
                sendJoinRequestEvent:InvokeServer(TARGET_USERNAME)
            end
        end)
    end
end

-- 4. Check Leave hoặc mất host trong 30s để về Lobby
local function checkTargetPlayerLeave()
    local targetPlayer = Players:FindFirstChild(TARGET_USERNAME)

    if targetPlayer then
        if not targetHasBeenSeen then
            targetHasBeenSeen = true
            print("Đã phát hiện " .. TARGET_USERNAME .. " xuất hiện trong game!")
        end
        missingTargetTimer = 0
    else
        if targetHasBeenSeen then
            missingTargetTimer = missingTargetTimer + 1
            print("Không thấy host " .. TARGET_USERNAME .. "! Đang đếm ngược: " .. missingTargetTimer .. "/30s")

            if missingTargetTimer >= 30 then
                print("Đã quá 30 giây không thấy host! Tiến hành về Lobby...")
                
                if returnToLobbyEvent then
                    pcall(function()
                        returnToLobbyEvent:FireServer()
                    end)
                end
                
                targetHasBeenSeen = false
                missingTargetTimer = 0
            end
        end
    end
end

-- Chống Idle Kick hệ thống
player.Idled:Connect(function()
    if getgenv().Config.AntiAFK then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end
end)

-- Áp dụng tối ưu hóa khi khởi chạy
applyOptimizations()

-- 5. Vòng lặp tổng hợp chính (chạy mỗi 1 giây)
task.spawn(function()
    local sellTimer = 0
    local buyTimer = 0
    local afkTimer = 0
    
    while true do
        checkTargetPlayerLeave()
        task.spawn(triggerJoin)
        updateBlackScreenStats() -- Cập nhật thông tin liên tục mỗi giây

        -- Kích hoạt nhảy chống AFK mỗi 30 giây
        afkTimer = afkTimer + 1
        if afkTimer >= 30 then
            afkTimer = 0
            triggerAntiAFK()
        end

        buyTimer = buyTimer + 1
        if buyTimer >= 2 then
            buyTimer = 0
            checkAndBuyGamepasses()
        end

        sellTimer = sellTimer + 1
        if sellTimer >= 3 then
            sellTimer = 0
            autoSellAll()
        end

        task.wait(1)
    end
end)
